					<font fontName="Lato" size="14"/>
				</textElement>
				<textFieldExpression><![CDATA["Gráfico 8: Hallazgos de incumplimientos por página"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="551" width="544" height="50" uuid="7ede2b54-8b9a-4b94-861d-5f8d995f49a7">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Lato&#xA;" size="12"/>
				</textElement>
				<text><![CDATA[El gráfico anterior muestra diferentes grupos de barras, cada grupo pertenece a una página evaluada en la evaluación automática. Cada barra del gráfico indica la cantidad de veces que se incumple cada criterio en la página correspondiente.]]></text>
			</staticText>
			<break>
				<reportElement x="0" y="621" width="100" height="1" uuid="28a47aa9-8240-44ce-ab5e-e9cab3180d6d"/>
			</break>
		</band>
