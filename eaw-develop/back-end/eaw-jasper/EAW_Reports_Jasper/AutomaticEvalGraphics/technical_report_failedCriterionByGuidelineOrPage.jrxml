				<textElement textAlignment="Center">
					<font fontName="Lato" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Tabla de cantidad de hallazgos automáticos por página]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="30" width="545" height="64" uuid="c51ce580-73c5-4d07-829e-eb67e4d2ad04">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Lato" size="12"/>
				</textElement>
				<text><![CDATA[La siguiente tabla contiene tres cabeceras de columnas: Páginas, Hallazgos(Cantidad) y URL. La primer columna de la tabla, corresponde al número de página evaluada; la segunda columna es la cantidad veces que se incumple un criterio en esa página; y la tercer columna es la dirección ’URL’ de la respectiva página.]]></text>
			</staticText>
