<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reports_criterions_by_evaluations" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9e05962e-12c8-47a6-8c99-b5e5453f2be6">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DA_EAW_PRODUCTION"/>
	<parameter name="evaluationsId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select distinct
    f.criterionsId
from
    Pages p,
    AutomaticEvaluatorPages aep,
    Findings f
where
    p.id = aep.pagesId
    and f.automaticEvaluatorPagesId = aep.id
    and p.evaluationsId =  $P{evaluationsId}]]>
	</queryString>
	<field name="criterionsId" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="criterionsId"/>
		<property name="com.jaspersoft.studio.field.label" value="criterionsId"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="Findings"/>
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
