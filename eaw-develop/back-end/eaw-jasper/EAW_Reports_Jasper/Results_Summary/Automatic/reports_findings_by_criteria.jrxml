	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DA_EAW_PRODUCTION"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="evaluationsId" class="java.lang.Integer"/>
	<parameter name="criterionsId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select distinct
    f.automaticDescriptionsId,
    ad.description,
    c.referenceLink,
    c.name,
    c.numberCriterion
from
    Pages p,
    AutomaticEvaluatorPages aep,
    Findings f,
    AutomaticDescriptions ad,
    Criterions c
where
    p.id = aep.pagesId
    and f.automaticEvaluatorPagesId = aep.id
    and ad.id = f.automaticDescriptionsId
    and c.id = f.criterionsId
    and p.evaluationsId =  $P{evaluationsId} 
    and f.criterionsId = $P{criterionsId}  ;]]>
	</queryString>
