				<textElement textAlignment="Center">
					<font fontName="Lato" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Tabla de cantidad de hallazgos manuales por pauta]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="30" width="555" height="60" uuid="66e0b326-03f6-4dc8-accb-31ef8b733a32">
