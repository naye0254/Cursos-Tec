				<textElement>
					<font fontName="Lato" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[5  RESUMEN DE RESULTADOS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="30" width="555" height="45" uuid="9621352f-f887-47df-9c5c-dce52a940a5c">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Lato&#xA;" size="12"/>
				</textElement>
				<text><![CDATA[Esta sección presenta gráficos y tablas con los resultados de las evaluaciones, mostrando así el estado del sitio en general, por cantidad de hallazgos encontrados por página y por pauta.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="75" width="516" height="30" forecolor="#377A81" uuid="1f2d10a4-7dd0-48e7-be03-c102f409531d">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Lato" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[5.1  CRITERIOS DEL EVALUADOR MANUAL]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="104" width="555" height="60" uuid="7ef0279f-291f-4a2b-8193-e875a0b78d40">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement>
					<font fontName="Lato&#xA;" size="12"/>
				</textElement>
				<text><![CDATA[El siguiente gráfico con ene el porcentaje de cumplimiento e incumplimiento de accesibilidad según los criterios de la WCAG2.1 evaluados por la evaluadores profesionales y la muestra de páginas obtenida.]]></text>
			</staticText>
			<pieChart>
				<chart isShowLegend="true" evaluationTime="Report" renderType="draw">
					<reportElement x="1" y="163" width="553" height="290" uuid="b94d5de3-4e16-477c-b87a-adb9b5d91900"/>
					<box bottomPadding="0"/>
					<chartTitle position="Bottom">
						<font fontName="Lato" size="14"/>
						<titleExpression><![CDATA["Gráfico 1: Porcentaje de accesibilidad del sitio"]]></titleExpression>
					</chartTitle>
					<chartSubtitle/>
					<chartLegend>
						<font fontName="Lato" size="12" isBold="true"/>
					</chartLegend>
				</chart>
				<pieDataset minPercentage="0.0">
					<dataset resetType="Report">
						<datasetRun subDataset="summaryGraphicDS" uuid="cec10f0d-5656-432a-9dd7-d662b89f00e4">
							<datasetParameter name="evaluationId">
								<datasetParameterExpression><![CDATA[$P{g_evaluationId}]]></datasetParameterExpression>
							</datasetParameter>
						</datasetRun>
					</dataset>
