			</pieChart>
			<staticText>
				<reportElement x="0" y="462" width="555" height="68" uuid="1b847782-82f5-49cf-b8da-86cbfd82527e">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<textElement textAlignment="Left">
					<font fontName="Lato" size="12"/>
				</textElement>
				<text><![CDATA[El gráfico anterior se muestra un gráfico tipo pastel, donde la fracción de color rojo indica el porcentaje de incumplimiento y la verde el porcetaje de cumplimiento. En caso de presentar sólo color verde, indica que no se encontraron barreras de accesibilidad en el sitio.]]></text>
			</staticText>
