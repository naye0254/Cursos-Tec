		<queryString language="SQL">
			<![CDATA[select
    f.htmlCode,
    f.htmlSelectorPath
from
    Pages p,
    AutomaticEvaluatorPages aep,
    Findings f
where
    p.id = aep.pagesId
    and f.automaticEvaluatorPagesId = aep.id
    and aep.pagesId =  $P{t_pagesId} 
    and f.automaticDescriptionsId= $P{t_automaticDescriptionsId} ;]]>
		</queryString>
