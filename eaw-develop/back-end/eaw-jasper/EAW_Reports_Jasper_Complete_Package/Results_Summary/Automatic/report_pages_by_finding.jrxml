	<parameter name="evaluationsId" class="java.lang.Integer"/>
	<parameter name="automaticDescriptionsId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select DISTINCT
    aep.pagesId
from
    Pages p,
    AutomaticEvaluatorPages aep,
    Findings f
where
    p.id = aep.pagesId
    and f.automaticEvaluatorPagesId = aep.id
    and p.evaluationsId =  $P{evaluationsId} 
    and f.automaticDescriptionsId =  $P{automaticDescriptionsId} ;]]>
	</queryString>
