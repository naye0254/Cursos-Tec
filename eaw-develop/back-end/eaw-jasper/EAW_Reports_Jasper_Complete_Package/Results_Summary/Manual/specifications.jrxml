	<parameter name="evaluationsId" class="java.lang.Integer"/>
	<parameter name="usersId" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT ROW_NUMBER() OVER (
		ORDER BY st.id
	) row_num,
    d.name deviceName,
    o.name systemName,
    b.name browserName,
    st.name toolName,
    s.id idSpecification
FROM `DS_EAW`.`Specifications` s
	inner join DS_EAW.SupportTools st ON
	 s.supportToolsId = st.id
    inner join DS_EAW.Devices d ON
     s.devicesId = d.id
    inner join DS_EAW.OperativeSystems o ON
     s.operativeSystemsId = o.id
    inner join DS_EAW.Browsers b ON
     s.browsersId = b.id
WHERE
	 s.`evaluationsId` =  $P{evaluationsId}  and usersId =  $P{usersId}]]>
	</queryString>
