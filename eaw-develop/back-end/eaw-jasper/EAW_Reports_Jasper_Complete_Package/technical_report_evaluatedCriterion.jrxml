	<subDataset name="criterionDataset" uuid="ec578ad5-06f7-49cc-ac0d-a95ed291aa32">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DA_EAW"/>
		<queryString language="SQL">
			<![CDATA[SELECT CONCAT_WS(' ', 'Criterio', c.numberCriterion, '-', c.name) AS Criterio, ROW_NUMBER() over (PARTITION BY c.id, c.numberCriterion, c.name ORDER BY c.id, c.numberCriterion, c.name) row_num from DS_EAW.Criterions c inner join DS_EAW.CriterionsByDisabilityRoles cd on c.id = cd.criterionsId group by c.id;]]>
		</queryString>
		<field name="Criterio" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Criterio"/>
			<property name="com.jaspersoft.studio.field.label" value="Criterio"/>
		</field>
		<field name="row_num" class="java.math.BigInteger">
			<property name="com.jaspersoft.studio.field.name" value="row_num"/>
			<property name="com.jaspersoft.studio.field.label" value="row_num"/>
		</field>
	</subDataset>
	<queryString>
		<![CDATA[select   `DS_EAW`.`Criterions`.id   FROM  `DS_EAW`.`Criterions` limit 1;]]>
	</queryString>
