				</textElement>
				<text><![CDATA[Tabla de cantidad de hallazgos manuales por página]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="30" width="545" height="64" uuid="183570e9-ad80-4d22-b9cc-86e5cbd5ff3a">
