	<parameter name="evaluationsId" class="java.lang.Integer"/>
	<parameter name="idSpecification" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT d.name,
	s.usersId
FROM `DS_EAW`.`Specifications` s
	inner join `DS_EAW`.`Disabilities` d ON 
	 s.`disabilitiesId` = d.id 
WHERE 
	 s.`evaluationsId` =  $P{evaluationsId} 
	 AND s.id =  $P{idSpecification}]]>
	</queryString>
