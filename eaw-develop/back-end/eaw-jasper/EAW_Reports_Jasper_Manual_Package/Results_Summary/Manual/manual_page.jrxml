	<parameter name="idSpecification" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT s.*,
       CONCAT_WS(' ', 'Página',
        ROW_NUMBER() OVER (
		ORDER BY s.id
	    ),'-', p.title) pageTitle,
       p.url
FROM `DS_EAW`.`SpecificationsByManualPages` s
	inner join `DS_EAW`.`ManualPages` m ON
	 s.manualPagesId = m.id
    inner join DS_EAW.Pages p ON
     m.pagesId = p.id
WHERE
	 s.specificationsId =  $P{idSpecification}]]>
	</queryString>
