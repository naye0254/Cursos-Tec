					<font fontName="Lato&#xA;" size="14" isBold="false"/>
				</textElement>
				<text><![CDATA[Indica que existe un error en el elemento o sección, por lo cual no es accesible.]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="340" width="525" height="40" uuid="45ae979a-3bcf-4c59-aacc-64fffd8f534f">
